+func TestRootedChownPresentedOwner(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("root 可以 chown 给任何 ID，无法验证错误照旧返回")
+	}
+	c, root, h := setupRootedHandlers(t, false)
