Subject: [PATCH] Clamp EDNS0 UDP response size to RFC 6891 minimum, guard nil answers, preserve RA and log DNS exchange failures

RFC 6891 section 6.2.3 requires EDNS0 UDP payload sizes below 512 bytes to be
treated as 512, and EDNS0 UDP sizes must not shrink TCP responses below
MaxMsgSize. Also guard against nil exchange answers, keep RecursionAvailable
set on SERVFAIL replies, and log failed exchanges for diagnostics (#771).

---
diff --git a/pkg/services/dns/cage_test.go b/pkg/services/dns/cage_test.go
index 21ffa81f..b42f0dfe 100644
--- a/pkg/services/dns/cage_test.go
+++ b/pkg/services/dns/cage_test.go
@@ -4,6 +4,7 @@ package dns
 import (
 	"context"
 	"errors"
+	"net"
 	"testing"
 
 	"github.com/miekg/dns"
@@ -23,7 +24,62 @@ func TestCageDNSFailureDoesNotUseHostResolver(t *testing.T) {
 	// A nil upstream would panic if the ordinary resolver path were used.
 	h := &dnsHandler{exchange: func(context.Context, *dns.Msg) (*dns.Msg, error) { return nil, errors.New("proxy down") }}
 	h.handle(w, q, dns.MaxMsgSize)
-	if w.msg == nil || w.msg.Rcode != dns.RcodeServerFailure {
-		t.Fatal("expected fail-closed SERVFAIL")
+	if w.msg == nil || w.msg.Rcode != dns.RcodeServerFailure || !w.msg.RecursionAvailable {
+		t.Fatalf("expected fail-closed SERVFAIL with RA=true, got %+v", w.msg)
+	}
+}
+
+func TestCageDNSNilAnswerFailsClosed(t *testing.T) {
+	q := new(dns.Msg)
+	q.SetQuestion("example.com.", dns.TypeA)
+	w := &cageWriter{}
+	h := &dnsHandler{exchange: func(context.Context, *dns.Msg) (*dns.Msg, error) { return nil, nil }}
+	h.handle(w, q, dns.MinMsgSize)
+	if w.msg == nil || w.msg.Rcode != dns.RcodeServerFailure || !w.msg.RecursionAvailable {
+		t.Fatalf("expected nil exchange reply to fail closed with SERVFAIL, got %+v", w.msg)
+	}
+}
+
+func TestCageDNSEDNSZeroUDPSizeDoesNotTruncateAnswers(t *testing.T) {
+	q := new(dns.Msg)
+	q.SetQuestion("deb.debian.org.", dns.TypeA)
+	q.SetEdns0(0, false)
+	w := &cageWriter{}
+	h := &dnsHandler{exchange: func(_ context.Context, req *dns.Msg) (*dns.Msg, error) {
+		reply := new(dns.Msg)
+		reply.SetReply(req)
+		reply.RecursionAvailable = true
+		reply.Answer = []dns.RR{&dns.A{
+			Hdr: dns.RR_Header{Name: req.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60},
+			A:   net.ParseIP("151.101.2.132").To4(),
+		}}
+		return reply, nil
+	}}
+	h.handleUDP(w, q)
+	if w.msg == nil || w.msg.Rcode != dns.RcodeSuccess || len(w.msg.Answer) != 1 || w.msg.Truncated {
+		t.Fatalf("EDNS0 UDPSize=0 truncated answer to empty: %+v", w.msg)
+	}
+}
+
+func TestCageDNSTCPPreservesMaxMsgSizeWithEDNS(t *testing.T) {
+	q := new(dns.Msg)
+	q.SetQuestion("large.example.", dns.TypeA)
+	q.SetEdns0(512, false)
+	w := &cageWriter{}
+	h := &dnsHandler{exchange: func(_ context.Context, req *dns.Msg) (*dns.Msg, error) {
+		reply := new(dns.Msg)
+		reply.SetReply(req)
+		reply.RecursionAvailable = true
+		for i := 1; i <= 40; i++ {
+			reply.Answer = append(reply.Answer, &dns.A{
+				Hdr: dns.RR_Header{Name: req.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60},
+				A:   net.IPv4(198, 51, 100, byte(i)),
+			})
+		}
+		return reply, nil
+	}}
+	h.handleTCP(w, q)
+	if w.msg == nil || len(w.msg.Answer) != 40 || w.msg.Truncated {
+		t.Fatalf("TCP response was shrunk to EDNS UDPSize: answers=%d truncated=%v", len(w.msg.Answer), w.msg.Truncated)
 	}
 }
diff --git a/pkg/services/dns/dns.go b/pkg/services/dns/dns.go
index 3ee284ad..ac7b11a4 100644
--- a/pkg/services/dns/dns.go
+++ b/pkg/services/dns/dns.go
@@ -39,17 +39,24 @@ func (h *dnsHandler) handle(w dns.ResponseWriter, r *dns.Msg, responseMessageSiz
 	m.RecursionAvailable = true
 	if h.exchange != nil {
 		answer, err := h.exchange(context.Background(), r)
-		if err != nil {
+		if err != nil || answer == nil {
+			if err != nil {
+				log.WithError(err).Warn("DNS exchange failed")
+			}
 			m.SetRcode(r, dns.RcodeServerFailure)
+			m.RecursionAvailable = true
 		} else {
 			m = answer
 		}
 	} else {
 		h.addAnswers(m)
 	}
-	edns0 := r.IsEdns0()
-	if edns0 != nil {
-		responseMessageSize = int(edns0.UDPSize())
+	// RFC 6891 section 6.2.3: EDNS0 UDP payload sizes below 512 must be treated
+	// as 512, and EDNS0 UDP sizes never shrink TCP's MaxMsgSize budget.
+	if responseMessageSize == dns.MinMsgSize {
+		if edns0 := r.IsEdns0(); edns0 != nil && int(edns0.UDPSize()) > responseMessageSize {
+			responseMessageSize = int(edns0.UDPSize())
+		}
 	}
 	m.Truncate(responseMessageSize)
 	if err := w.WriteMsg(m); err != nil {
