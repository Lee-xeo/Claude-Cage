diff --git a/pkg/driver/qemu/graphics.go b/pkg/driver/qemu/graphics.go
new file mode 100644
index 0000000..3a5564a
--- /dev/null
+++ b/pkg/driver/qemu/graphics.go
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: Apache-2.0
+package qemu
+
+// Accelerated variants expose real VirGL rendering, not a renamed 2D device.
+func graphicsDevice(arch string, windows, accelerated bool) string {
+	if arch == "x86_64" || arch == "riscv64" {
+		if accelerated {
+			return "virtio-vga-gl"
+		}
+		return "virtio-vga"
+	}
+	if windows {
+		return "ramfb"
+	}
+	if accelerated {
+		return "virtio-gpu-gl-pci"
+	}
+	return "virtio-gpu"
+}
diff --git a/pkg/driver/qemu/graphics_test.go b/pkg/driver/qemu/graphics_test.go
new file mode 100644
index 0000000..f998789
--- /dev/null
+++ b/pkg/driver/qemu/graphics_test.go
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: Apache-2.0
+package qemu
+
+import "testing"
+
+func TestGraphicsDeviceSelection(t *testing.T) {
+	for _, row := range []struct {
+		arch                 string
+		windows, accelerated bool
+		device               string
+	}{{"x86_64", false, false, "virtio-vga"}, {"x86_64", false, true, "virtio-vga-gl"}, {"aarch64", false, false, "virtio-gpu"}, {"aarch64", false, true, "virtio-gpu-gl-pci"}, {"aarch64", true, false, "ramfb"}} {
+		if got := graphicsDevice(row.arch, row.windows, row.accelerated); got != row.device {
+			t.Fatalf("%s: %s != %s", row.arch, got, row.device)
+		}
+	}
+}
