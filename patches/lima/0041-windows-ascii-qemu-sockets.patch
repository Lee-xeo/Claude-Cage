-	conn, err := (&net.Dialer{}).DialContext(ctx, "unix", filepath.Join(l.Instance.Dir, filenames.QMPSock))
+	conn, err := (&net.Dialer{}).DialContext(ctx, "unix", filepath.Join(socketDir(l.Instance.Dir), filenames.QMPSock))
