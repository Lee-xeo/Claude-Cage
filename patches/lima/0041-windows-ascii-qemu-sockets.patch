diff --git a/pkg/driver/qemu/socketdir.go b/pkg/driver/qemu/socketdir.go
new file mode 100644
index 00000000..d996f334
--- /dev/null
+++ b/pkg/driver/qemu/socketdir.go
@@ -0,0 +1,13 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package qemu
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
